# ==============================================================================
# THE SMART WORTH (TSW) - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# This file contains ONLY placeholder keys. Never commit real production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Cloudflare Pages Build Settings)
# Only public values prefixed with VITE_ are bundled into client-side code.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
VITE_RAZORPAY_KEY_ID=rzp_live_your_public_key_id
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_ADMIN_EMAIL=helplinesmartworth@gmail.com
VITE_API_URL=https://api.thesmartworth.site/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT SECRETS (Cloudflare Workers Encrypted Secrets)
# Set these encrypted secrets using `wrangler secret put <KEY>`:
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
RAZORPAY_KEY_ID=rzp_live_your_public_key_id
RAZORPAY_KEY_SECRET=your-razorpay-private-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key-here
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here
JWT_SECRET=your-jwt-auth-secret-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. DOMAIN & CORS CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_URL=https://thesmartworth.site
NODE_ENV=production
