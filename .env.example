CLOUDINARY_API_SECRET=your-cloudinary-api-secret
GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET=your-jwt-secret

# Deployment
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://thesmartworth.site
