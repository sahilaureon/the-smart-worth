# Frontend Environment Variables (Prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_ADMIN_EMAIL=helplinesmartworth@gmail.com
VITE_API_URL=https://api.thesmartworth.site/api

# Backend Environment Variables (Sensitive, NOT exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
